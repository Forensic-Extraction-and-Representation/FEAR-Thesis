@code {

    public class DataTableConfig
    {
        public string Id { get; set; }
        public string Title { get; set; }
        public string[] Columns { get; set; }
        public List<object[]> Data { get; set; }
    }

    [Parameter] public DataTableConfig TableConfig { get; set; }

    private string modalId => $"data-table-modal-{TableConfig.Id}";

    [Inject] IJSRuntime JSRuntime { get; set; }
    [Inject] BootstrapInterop BootstrapInterop { get; set; } 
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await BootstrapInterop.InitializeModal(modalId, "false", "15%", "10%");
            await BootstrapInterop.DraggableModal(modalId);
        }
    }

    private async Task closeModal(string modalId)
    {
        await BootstrapInterop.CloseModal(modalId);
    }
}