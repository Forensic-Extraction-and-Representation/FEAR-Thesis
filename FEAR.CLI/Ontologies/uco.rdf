    <rdfs:seeAlso rdf:resource="http://purl.org/co/followedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/WindowsSystemRestore">
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/WindowsSystemRestore"/>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/ObservableObject"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">WindowsSystemRestore</rdfs:label>
    <rdfs:comment xml:lang="en">A Windows system restore is a capture of a Windows computer's state (including system files, installed applications, Windows Registry, and system settings) at a particular point in time such that the computer can be reverted to that state in the event of system malfunctions or other problems. [based on https://en.wikipedia.org/wiki/System_Restore]</rdfs:comment>
  </rdf:Description>
