  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/MSISDN">
    <rdfs:label xml:lang="en">MSISDN</rdfs:label>
    <rdfs:comment xml:lang="en">Mobile Station International Subscriber Directory Number (MSISDN) is a number used to identify a mobile phone number internationally. MSISDN is defined by the E.164 numbering plan. This number includes a country code and a National Destination Code which identifies the subscriber's operator.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
