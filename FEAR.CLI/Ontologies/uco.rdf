    <sh:property rdf:nodeID="n7fbd4071813944b789bfa0d543a2b1a9b32"/>
    <rdfs:comment xml:lang="en">An alternate data stream facet is a grouping of characteristics unique to data content stored within an NTFS file that is independent of the standard content stream of the file and is hidden from access by default NTFS file viewing mechanisms.</rdfs:comment>
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/AlternateDataStreamFacet"/>
