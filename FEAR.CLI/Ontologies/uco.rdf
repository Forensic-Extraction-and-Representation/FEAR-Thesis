  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/MutexFacet">
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/core/Facet"/>
    <rdfs:comment xml:lang="en">A mutex facet is a grouping of characteristics unique to a mechanism that enforces limits on access to a resource when there are many threads of execution. A mutex is designed to enforce a mutual exclusion concurrency control policy, and with a variety of possible methods there exists multiple unique implementations for different applications. [based on https://en.wikipedia.org/wiki/Lock_(computer_science)]</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:property rdf:nodeID="n7fbd4071813944b789bfa0d543a2b1a9b508"/>
