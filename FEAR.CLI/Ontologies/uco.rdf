  <rdf:Description rdf:nodeID="n7fbd4071813944b789bfa0d543a2b1a9b36">
    <sh:datatype rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <sh:path rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/androidFingerprint"/>
    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b31">
    <rdfs:seeAlso rdf:resource="https://datatracker.ietf.org/doc/html/rfc4122#section-4.1.3"/>
    <sh:message xml:lang="en">UcoThings are suggested to end with a UUID.</sh:message>
    <sh:select>
			PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
			PREFIX core: &lt;https://ontology.unifiedcyberontology.org/uco/core/&gt;
			SELECT $this
			WHERE {
			        $this a/rdfs:subClassOf* core:UcoThing .
			        FILTER (
			                ! REGEX (
			                        STR($this),
			                        "[0-9a-f]{8}-[0-9a-f]{4}-[0-5][0-9a-f]{3}-[0-9a-f]{4}-[0-9a-f]{12}$",
			                        "i"
			                )
			        )
			}
		</sh:select>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/sizeOfHeaders">
    <rdfs:comment xml:lang="en">Specifies the combined size of the MS-DOS, PE header, and section headers, rounded up a multiple of the value specified in the file_alignment header.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#unsignedInt"/>
    <rdfs:label xml:lang="en">sizeOfHeaders</rdfs:label>
  </rdf:Description>
