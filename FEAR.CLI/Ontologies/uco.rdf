    <rdfs:comment xml:lang="en">An account is an arrangement with an entity to enable and control the provision of some capability or service.</rdfs:comment>
    <rdfs:label xml:lang="en">Account</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/types/Identifier">
    <rdfs:comment xml:lang="en">An identifier is a string conformant to the specified UUID-based format for UCO object identifiers.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
