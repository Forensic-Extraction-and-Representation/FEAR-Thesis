    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/DigitalAccount"/>
    <rdfs:comment xml:lang="en">A user account is an account controlling a user's access to a network, system or platform.</rdfs:comment>
    <rdfs:label xml:lang="en">UserAccount</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n17e577fff54c40c980f49cc70b6c46e1b37">
