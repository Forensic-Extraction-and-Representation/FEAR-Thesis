    <sh:path rdf:nodeID="n3d7779412bd04ec6826a477924a894e4b14"/>
    <sh:message xml:lang="en">'The import closure of [ontology] O SHOULD NOT contain ontologies O_1 and O_2 such that ... O_1 contains an ontology annotation owl:incompatibleWith with the value equal to ... the version IRI of O_2.'  The focusNode is incompatible with some O_1 within the transitive closure of some O.</sh:message>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
  </rdf:Description>
