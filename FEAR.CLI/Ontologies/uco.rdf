  <rdf:Description rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b35">
    <sh:message xml:lang="en">hasFacet must not be used to link two objects to one Facet.</sh:message>
    <sh:select>
			PREFIX core: &lt;https://ontology.unifiedcyberontology.org/uco/core/&gt;
			PREFIX owl: &lt;http://www.w3.org/2002/07/owl#&gt;
			SELECT $this ?value
			WHERE {
				?value core:hasFacet $this .
				?nOtherValue core:hasFacet $this .
				FILTER ( ?value != ?nOtherValue )
				FILTER NOT EXISTS {
					?value owl:sameAs|^owl:sameAs ?nOtherValue .
				}
			}
			</sh:select>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
  </rdf:Description>
