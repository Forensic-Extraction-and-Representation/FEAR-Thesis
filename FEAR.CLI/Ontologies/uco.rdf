  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/WindowsHook">
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/ObservableObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/WindowsHook"/>
    <rdfs:label xml:lang="en">WindowsHook</rdfs:label>
    <rdfs:comment xml:lang="en">A Windows hook is a mechanism by which an application can intercept events, such as messages, mouse actions, and keystrokes within the Windows operating system. A function that intercepts a particular type of event is known as a hook procedure. A hook procedure can act on each event it receives, and then modify or discard the event. [based on https://docs.microsoft.com/en-us/windows/win32/winmsg/about-hooks]</rdfs:comment>
  </rdf:Description>
