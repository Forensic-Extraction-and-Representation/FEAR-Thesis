  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/ApplicationAccountFacet">
    <rdfs:label xml:lang="en">ApplicationAccountFacet</rdfs:label>
    <rdfs:comment xml:lang="en">An application account facet is a grouping of characteristics unique to an account within a particular software program designed for end users.</rdfs:comment>
    <sh:property rdf:nodeID="n7fbd4071813944b789bfa0d543a2b1a9b44"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
