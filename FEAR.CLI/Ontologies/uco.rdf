  <rdf:Description rdf:nodeID="n3d7779412bd04ec6826a477924a894e4b11">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    <sh:select>
				PREFIX rdf: &lt;http://www.w3.org/1999/02/22-rdf-syntax-ns#&gt;
				PREFIX sh: &lt;http://www.w3.org/ns/shacl#&gt;
				SELECT $this ?value
				WHERE {
					?value
						sh:datatype ?nDatatype ;
						sh:path / rdf:rest* ?nLastSequenceMember ;
						.
					?nLastSequenceMember
						rdf:first $this ;
						rdf:rest rdf:nil ;
						.
				}
		</sh:select>
    <sh:message xml:lang="en">An OWL Object Property cannot use a SHACL DatatypeConstraintComponent.</sh:message>
  </rdf:Description>
