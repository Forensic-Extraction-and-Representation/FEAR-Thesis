  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/tool/CompilerType">
    <sh:property rdf:nodeID="n7542dd5efa004bb688f7309551f96b02b17"/>
    <sh:property rdf:nodeID="n7542dd5efa004bb688f7309551f96b02b16"/>
