  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/Directory">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A directory is a file system cataloging structure which contains references to other computer files, and possibly other directories. On many computers, directories are known as folders, or drawers, analogous to a workbench or the traditional office filing cabinet. In UNIX a directory is implemented as a special file. [based on https://en.wikipedia.org/wiki/Directory_(computing)]</rdfs:comment>
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/Directory"/>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/FileSystemObject"/>
    <rdfs:label xml:lang="en">Directory</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7fbd4071813944b789bfa0d543a2b1a9b865">
