  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/Tablet">
    <rdfs:comment xml:lang="en-US">A tablet is a mobile computer that is primarily operated by touching the screen. (Devices categorized by their manufacturer as a Tablet)</rdfs:comment>
