  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/owl/incompatibleWith-imported-ontology-iri-shape">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:message xml:lang="en">'The import closure of [ontology] O SHOULD NOT contain ontologies O_1 and O_2 such that ... O_1 contains an ontology annotation owl:incompatibleWith with the value equal to either the ontology IRI or the version IRI of O_2.'  The focusNode, or a versionIRI of it, is imported within the transitive closure of some O, but is incompatible with some O_1 also within the transitive closure of O.</sh:message>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/owl2-syntax/#Imports"/>
    <sh:severity rdf:resource="http://www.w3.org/ns/shacl#Warning"/>
    <sh:not rdf:nodeID="n3d7779412bd04ec6826a477924a894e4b13"/>
    <sh:targetObjectsOf rdf:resource="http://www.w3.org/2002/07/owl#incompatibleWith"/>
