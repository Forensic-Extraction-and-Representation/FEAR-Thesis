    <sh:maxCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</sh:maxCount>
    <sh:nodeKind rdf:resource="http://www.w3.org/ns/shacl#Literal"/>
    <sh:path rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/clockSetting"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n3d7779412bd04ec6826a477924a894e4b6">
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/2012/REC-owl2-syntax-20121211/#Typing_Constraints_of_OWL_2_DL"/>
    <sh:select>
			PREFIX owl: &lt;http://www.w3.org/2002/07/owl#&gt;
			SELECT $this
			WHERE {
				$this a owl:ObjectProperty ;
			}
		</sh:select>
    <sh:message xml:lang="en">An IRI may not be a member of both an owl:AnnotationProperty and owl:ObjectProperty.</sh:message>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
  </rdf:Description>
