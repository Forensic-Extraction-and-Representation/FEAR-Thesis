  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/EmailAccount">
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/EmailAccount"/>
    <rdfs:label xml:lang="en">EmailAccount</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/DigitalAccount"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An email account is an arrangement with an entity to enable and control the provision of electronic mail (email) capabilities or services.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/API">
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/API"/>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/ObservableObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:comment xml:lang="en">An API (application programming interface) is a computing interface that defines interactions between multiple software or mixed hardware-software intermediaries. It defines the kinds of calls or requests that can be made, how to make them, the data formats that should be used, the conventions to follow, etc. [based on https://en.wikipedia.org/wiki/API]</rdfs:comment>
    <rdfs:label xml:lang="en">API</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/identity/IdentifierFacet">
    <rdfs:comment xml:lang="en">Identifier is a grouping of characteristics unique to information that uniquely and specifically identities an entity.</rdfs:comment>
