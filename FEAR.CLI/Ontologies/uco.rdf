  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/BlackberryPhone">
    <rdfs:label xml:lang="en-US">BlackberryPhone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/SmartPhone"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/BlackberryPhone"/>
    <rdfs:comment xml:lang="en-US">A blackberry phone is a smart phone that applies the Blackberry OS mobile operating system. (Blackberry 10 re-introduces Blackberry OS, prior to that the OS was Android.)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/SymbolicLinkFacet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/observable/SymbolicLinkFacet"/>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/core/Facet"/>
    <sh:property rdf:nodeID="n7fbd4071813944b789bfa0d543a2b1a9b716"/>
    <rdfs:comment xml:lang="en">A symbolic link facet is a grouping of characteristics unique to a file that contains a reference to another file or directory in the form of an absolute or relative path and that affects pathname resolution. [based on https://en.wikipedia.org/wiki/Symbolic_link]</rdfs:comment>
    <rdfs:label xml:lang="en">SymbolicLinkFacet</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/observable/UserAccount">
