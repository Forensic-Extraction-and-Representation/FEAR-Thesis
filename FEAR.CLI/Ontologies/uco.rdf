  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/core/UcoObject">
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b26"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b21"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b22"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b28"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b24"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b27"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b23"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b20"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b29"/>
    <sh:property rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b25"/>
    <rdfs:comment xml:lang="en">A UCO object is a representation of a fundamental concept either directly inherent to the cyber domain or indirectly related to the cyber domain and necessary for contextually characterizing cyber domain concepts and relationships. Within the Unified Cyber Ontology (UCO) structure this is the base class acting as a consistent, unifying and interoperable foundation for all explicit and inter-relatable content objects.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#NodeShape"/>
    <rdfs:subClassOf rdf:resource="https://ontology.unifiedcyberontology.org/uco/core/UcoThing"/>
    <sh:targetClass rdf:resource="https://ontology.unifiedcyberontology.org/uco/core/UcoObject"/>
    <rdfs:label xml:lang="en">UcoObject</rdfs:label>
  </rdf:Description>
