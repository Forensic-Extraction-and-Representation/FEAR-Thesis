  <rdf:Description rdf:nodeID="n3d7779412bd04ec6826a477924a894e4b10">
    <sh:message xml:lang="en">The subject of a triple with rdf:first as predicate must be a blank node.</sh:message>
    <rdfs:comment xml:lang="en">This requirement is determined from review of the canonical parsing process in Section 3 of the OWL 2 mapping to RDF.  Table 5 removes any triple matching the pattern 'x a rdf:List`.  All other references throughout Section 3 to rdf:first are identified as blank nodes.  Therefore, any non-blank node that is an rdf:List will not be mapped and consumed by the mapping process, making the graph non-conformant with OWL 2 DL.</rdfs:comment>
    <sh:select>
			SELECT $this
			WHERE {
				FILTER isIRI($this)
			}
		</sh:select>
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    <rdfs:seeAlso rdf:resource="https://www.w3.org/TR/2012/REC-owl2-mapping-to-rdf-20121211/#Mapping_from_RDF_Graphs_to_the_Structural_Specification"/>
  </rdf:Description>
