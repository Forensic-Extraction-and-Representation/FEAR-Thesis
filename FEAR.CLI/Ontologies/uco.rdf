  <rdf:Description rdf:nodeID="nf72b0b43c9ed4ed9a5421c0a62d31786b30">
    <rdf:type rdf:resource="http://www.w3.org/ns/shacl#SPARQLConstraint"/>
    <sh:select>
			PREFIX rdfs: &lt;http://www.w3.org/2000/01/rdf-schema#&gt;
			PREFIX core: &lt;https://ontology.unifiedcyberontology.org/uco/core/&gt;
			SELECT $this
			WHERE {
			        $this a/rdfs:subClassOf* core:UcoThing .
			        FILTER isBlank ($this)
			}
		</sh:select>
    <sh:message xml:lang="en">UcoThings are required to not be blank nodes.</sh:message>
  </rdf:Description>
