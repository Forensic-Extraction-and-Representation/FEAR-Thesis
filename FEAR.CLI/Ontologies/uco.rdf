    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.unifiedcyberontology.org/uco/identity/PhysicalInfoFacet">
