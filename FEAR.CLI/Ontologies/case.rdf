    <rdf:first rdf:datatype="https://ontology.caseontology.org/case/vocabulary/InvestigationFormVocab">case</rdf:first>
    <rdf:rest rdf:nodeID="n662cb83579104cbab664d93a7c29444eb3"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb3d123b1b696452d80df554ebc732a57b3">
