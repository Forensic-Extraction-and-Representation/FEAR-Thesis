@page
@model FEAR.Hosted.Pages.Cases.CreateModel
@{
}
@{
    ViewData["Title"] = "Create";
}

<a asp-page="/Cases/Index">Back to List</a>
<h2>Create</h2>
<div class="container">
    <form method="post">
