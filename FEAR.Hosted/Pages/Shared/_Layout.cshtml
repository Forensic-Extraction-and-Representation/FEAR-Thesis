@using FEAR.Domain;
@using FEAR.Host.Core.Identity;

@{
    var _permissionProvider = Context.RequestServices.GetService<IPermissionProvider>();
    var _identityProvider = Context.RequestServices.GetService<IIdentityProvider>();

    bool canAccessAdmin = false;
    if (User.Identity?.IsAuthenticated == true)
    {
        var CurrentUserInfo = _identityProvider.GetUserInfoFromClaim(User);
        var CurrentUser = _identityProvider.GetUserFromClaim(CurrentUserInfo);
        // Assuming ActionDefinitions is available in scope
        var result = _permissionProvider.CanPerformAnySystemAction(CurrentUser, ActionDefinitions.System.All.Select(t => t.Name));
        canAccessAdmin = result.IsApproved;
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (!Context.Request.Query.ContainsKey("embedded"))
    {
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
                <div class="container">
                    <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                        <img src="~/images/FEAR-Logo.png" alt="FEAR Logo" width="30" height="30" class="d-inline-block align-text-top me-2" />
                        FEAR.Hosted
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                            </li>
                            @if (canAccessAdmin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="/administration">Administration</a>
                                </li>
                            }
                        </ul>
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>