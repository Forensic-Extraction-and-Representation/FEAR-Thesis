@using MudBlazor
@using FEAR.Host.Domain.Api.Investigation

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.Info" />
            <MudText Typo="Typo.h6">Investigation Info - @InvestigationName</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            <MudText>Loading...</MudText>
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true">

                <MudTabPanel Text="Graph Statistics" Icon="@Icons.Material.Filled.BarChart">
                    @if (_stats == null || !_stats.IsAvailable)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            Graph statistics are not yet available. The investigation graph service must be running and have processed artifacts.
                        </MudAlert>
                    }
                    else
                    {
                        <MudGrid Class="mt-2">
                            <MudItem xs="6" sm="4">
                                <MudPaper Class="pa-4 text-center" Elevation="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" Size="Size.Large" />
                                    <MudText Typo="Typo.h4" Color="Color.Primary">@_stats.TriplesCount.ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Triples</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudPaper Class="pa-4 text-center" Elevation="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Person" Color="Color.Secondary" Size="Size.Large" />
                                    <MudText Typo="Typo.h4" Color="Color.Secondary">@_stats.SubjectsCount.ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Subjects (Entities)</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudPaper Class="pa-4 text-center" Elevation="2">
                                    <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Tertiary" Size="Size.Large" />
                                    <MudText Typo="Typo.h4" Color="Color.Tertiary">@_stats.PredicatesCount.ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Predicates</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudPaper Class="pa-4 text-center" Elevation="2">
                                    <MudIcon Icon="@Icons.Material.Filled.Circle" Color="Color.Info" Size="Size.Large" />
                                    <MudText Typo="Typo.h4" Color="Color.Info">@_stats.ObjectsCount.ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Objects</MudText>
                                </MudPaper>
                            </MudItem>
                            <MudItem xs="6" sm="4">
                                <MudPaper Class="pa-4 text-center" Elevation="2">
                                    <MudIcon Icon="@Icons.Material.Filled.TextFields" Color="Color.Warning" Size="Size.Large" />
                                    <MudText Typo="Typo.h4" Color="Color.Warning">@_stats.LiteralsCount.ToString("N0")</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Literals</MudText>
                                </MudPaper>
                            </MudItem>
                        </MudGrid>
                    }

                    <MudStack Row="true" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="LoadStatistics">Refresh</MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadGraphData"
                                   Disabled="_isDownloadingGraph">
                            @if (_isDownloadingGraph)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            }
                            Download Graph as TTL
                        </MudButton>
                    </MudStack>

                    @if (_graphDownloadError != null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">@_graphDownloadError</MudAlert>
                    }
                </MudTabPanel>

                <MudTabPanel Text="Ontology" Icon="@Icons.Material.Filled.Schema">
                    @if (_isLoadingOntology)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                        <MudText>Loading ontology...</MudText>
                    }
                    else if (!_isOntologyAvailable)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-2">
                            No ontology is available for this investigation yet. The ontology is generated when the investigation processes artifacts.
                        </MudAlert>
                    }
                    else
                    {
                        <MudPaper Class="pa-2 mt-2" Style="max-height: 450px; overflow: auto; background-color: var(--mud-palette-background-grey);">
                            <pre style="margin: 0; white-space: pre-wrap; word-break: break-word; font-family: monospace; font-size: 0.85rem;">@_ontologyContent</pre>
                        </MudPaper>
                    }

                    @if (_ontologyError != null)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">@_ontologyError</MudAlert>
                    }

                    <MudStack Row="true" Spacing="2" Class="mt-4">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="LoadOntology">Refresh</MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="DownloadOntology"
                                   Disabled="!_isOntologyAvailable">Download Ontology as TTL</MudButton>
                    </MudStack>
                </MudTabPanel>

            </MudTabs>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">Close</MudButton>
    </DialogActions>
</MudDialog>
