@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" />
            <MudText Typo="Typo.h6">Investigation Ontology - @InvestigationName</MudText>
        </MudStack>
    </TitleContent>

    <DialogContent>
        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            <MudText>Loading ontology...</MudText>
        }
        else if (!_isAvailable)
        {
            <MudAlert Severity="Severity.Info">No ontology is available for this investigation yet. The ontology is generated when the investigation processes artifacts.</MudAlert>
        }
        else
        {
            <MudPaper Class="pa-2" Style="max-height: 600px; overflow: auto; background-color: var(--mud-palette-background-grey);">
                <pre style="margin: 0; white-space: pre-wrap; word-break: break-word; font-family: monospace; font-size: 0.85rem;">@_ontologyContent</pre>
            </MudPaper>
        }

        @if (_hasError)
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_errorMessage</MudAlert>
        }
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">Close</MudButton>
    </DialogActions>
</MudDialog>
