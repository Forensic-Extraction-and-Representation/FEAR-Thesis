@page "/system-colormap"
@using FEAR.Blazor.Shared.Components
@using FEAR.Blazor.Shared.Components.ColorMaps
@using FEAR.Domain.Model.ColorMap
@inject FEAR.Admin.Services.Management.ColorMapAdminService Service
@using MudBlazor
@attribute [Authorize]

<MudPaper Class="pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">System Color Map</MudText>
        <MudButton Variant="Variant.Outlined" OnClick="Reload">Reload</MudButton>
    </MudStack>

    @if (set == null)
    {
        <MudText>Loading...</MudText>
    }
    else
    {
        <ColorMapSetEditor Set="set" />
        <MudStack Row="true" Spacing="2" Class="mt-2" Justify="Justify.FlexEnd">
            @if (set.ColorMapSetId != Guid.Empty)
            {
                <MudButton Color="Color.Error" Variant="Variant.Outlined" OnClick="Delete">Delete</MudButton>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save</MudButton>
        </MudStack>
    }
</MudPaper>

@code {
    private ColorMapSet? set;

    protected override async Task OnInitializedAsync()
    {
        await Reload();
    }

    private async Task Reload()
    {
        var sets = await Service.QueryAsync(ColorMapEntityDiscriminator.None, null);
        set = sets.FirstOrDefault() ?? new ColorMapSet
        {
            Name = "System Color Map",
            EntityDiscriminator = ColorMapEntityDiscriminator.None,
            EntityId = Guid.Empty.ToString(),
            ColorMaps = new List<FEAR.Domain.Model.ColorMap.ColorMap>()
        };
    }

    private async Task Save()
    {
        if (set == null) return;
        set.ColorMapSetId = await Service.UpsertAsync(set);
    }

    private async Task Delete()
    {
        if (set == null || set.ColorMapSetId == Guid.Empty) return;
        await Service.DeleteAsync(set.ColorMapSetId);
        set = new ColorMapSet
        {
            Name = "System Color Map",
            EntityDiscriminator = ColorMapEntityDiscriminator.None,
            EntityId = Guid.Empty.ToString(),
            ColorMaps = new List<FEAR.Domain.Model.ColorMap.ColorMap>()
        };
    }
}
