@page "/"
@using MudBlazor
@using FEAR.Blazor.Shared.Components.ConfigurationEditor
@using FEAR.Blazor.Shared.Components.ConfigurationEditor.Model
<PageTitle>FEAR Admin</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="d-flex flex-column align-center justify-center pt-16">
    <MudImage Src="images/FEAR-Logo.png" Alt="FEAR Logo" Height="180" Class="mb-6" />

    <MudText Typo="Typo.h2" Align="Align.Center" Class="mb-2">FEAR</MudText>
    <MudText Typo="Typo.h5" Align="Align.Center" Color="Color.Secondary" Class="mb-6">Forensic Extraction and Representation</MudText>

    <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Default">
        Welcome to the Administration Console.
    </MudText>
    <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary">
        Manage investigations, telemetry, and system configuration.
    </MudText>
</MudContainer>


