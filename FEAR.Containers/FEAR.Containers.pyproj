<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>51b49de2-c705-4987-9959-31b258f9957d</ProjectGuid>
    <ProjectHome>.</ProjectHome>
    <StartupFile>FEAR.Containers.py</StartupFile>
    <SearchPath>
    </SearchPath>
    <WorkingDirectory>.</WorkingDirectory>
    <OutputPath>.</OutputPath>
    <Name>FEAR.Containers</Name>
    <RootNamespace>FEAR.Containers</RootNamespace>
    <InterpreterId>MSBuild|containers-env|$(MSBuildProjectFullPath)</InterpreterId>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugSymbols>true</DebugSymbols>
    <EnableUnmanagedDebugging>false</EnableUnmanagedDebugging>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Postgres\Dockerfile" />
    <Compile Include="FEAR.Containers.py" />
    <Compile Include="FEAR\Dockerfile" />
    <Compile Include="src\certificate_generation.py" />
    <Compile Include="src\config_file_utils.py" />
    <Compile Include="src\crypto_helpers.py" />
    <Compile Include="src\prepare_certificates.py" />
    <Compile Include="src\file_utils.py" />
    <Compile Include="src\keyconfig_generation.py" />
    <Compile Include="src\prepare_nginx.py" />
    <Compile Include="src\prepare_secrets.py" />
    <Compile Include="src\prepare_settings.py" />
    <Compile Include="src\questioning.py" />
    <Compile Include="src\random_helpers.py" />
    <Compile Include="src\__init__.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="FEAR\case_creation_defaults.json" />
    <Content Include="FEAR\initial_color_maps.json" />
    <Content Include="Postgres\.dockerignore" />
    <Content Include="Postgres\docker-entrypoint.sh" />
    <Content Include="docker-compose.yaml" />
    <Content Include="FEAR\.dockerignore" />
    <Content Include="FEAR\admin-appsettings.json" />
    <Content Include="FEAR\initial_cases.json" />
    <Content Include="FEAR\docker-entrypoint.sh" />
    <Content Include="FEAR\hosted-appsettings.json" />
    <Content Include="FEAR\hosted-keyconfig.json" />
    <Content Include="FEAR\wasm-appsettings.json" />
    <Content Include="README.md" />
    <Content Include="Requirements.txt" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="FEAR\" />
    <Folder Include="Postgres\" />
    <Folder Include="src\" />
  </ItemGroup>
  <ItemGroup>
    <Interpreter Include="containers-env\">
      <Id>containers-env</Id>
      <Version>3.14</Version>
      <Description>containers-env (Python 3.14.3)</Description>
      <InterpreterPath>Scripts\python.exe</InterpreterPath>
      <WindowsInterpreterPath>Scripts\pythonw.exe</WindowsInterpreterPath>
      <PathEnvironmentVariable>PYTHONPATH</PathEnvironmentVariable>
      <Architecture>X64</Architecture>
    </Interpreter>
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)\Python Tools\Microsoft.PythonTools.targets" />
  <!-- Uncomment the CoreCompile target to enable the Build command in
       Visual Studio and specify your pre- and post-build commands in
       the BeforeBuild and AfterBuild targets below. -->
  <!--<Target Name="CoreCompile" />-->
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
</Project>