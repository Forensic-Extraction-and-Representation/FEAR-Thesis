@using MudBlazor
@typeparam T

<MudDialog @bind-Visible="_visible" Options="DialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @HeaderTemplate(EditingEntry)
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudPaper Class="pa-4">
                        <MudForm @ref="form" @bind-IsValid="@success" Model="EditingEntry" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit">
                            @FormContentTemplate(EditingEntry)
                        </MudForm>
                    <MudOverlay Visible="_loading" DarkBackground="true" Absolute="true">
                        <MudProgressCircular Color="Color.Secondary" Indeterminate="true" />
                    </MudOverlay>
                </MudPaper>
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEntry" Disabled="!success || form == null || _loading || (IsSaveDisabled != null && IsSaveDisabled())" Class="px-10">Save</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => CloseDialog(false)" Disabled="_loading" Class="px-10">Close</MudButton>
    </DialogActions>
</MudDialog>
